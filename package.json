{
  "name": "svg3dprint",
  "version": "0.1.0",
  "description": "Turn SVGs into multicolour 3D prints: one part per colour, with a printability check",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p .",
    "dev": "tsc -p . --watch",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "svg",
    "3d-printing",
    "3mf",
    "stl",
    "multicolor",
    "cli"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "manifold-3d": "^3.5.4",
    "opentype.js": "^2.0.0",
    "woff2-encoder": "^2.0.0"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./writers": {
      "types": "./dist/writers/index.d.ts",
      "default": "./dist/writers/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "svg3dprint": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
